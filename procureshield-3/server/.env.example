# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procureshield
DATABASE_SSL=false
DATABASE_SEED=true
DATABASE_POOL_MAX=10

# ProcureShield demo auth
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

# Python engine
ENGINE_URL=http://127.0.0.1:8000

# OpenRouter AI (optional until an API key is added)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=ProcureShield
