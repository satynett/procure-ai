# Copy to server/.env (Node BFF) and adjust as needed.

# --- Node BFF -------------------------------------------------------------
PORT=4000
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

# --- ProcureShield engine connection -------------------------------------
# Use 127.0.0.1 rather than localhost: Node resolves localhost to ::1 first,
# while uvicorn binds IPv4 by default.
ENGINE_URL=http://127.0.0.1:8000
ENGINE_TIMEOUT_MS=60000
# Retrain the GAT on every analysis (slow; usually left false and triggered
# from Settings -> Train model instead).
ENGINE_TRAIN=false
# false = deterministic graph rules only, no model contribution.
ENGINE_USE_MODEL=true

# --- Engine-side settings (read by the Python service) -------------------
# PROCURESHIELD_ALERT_THRESHOLD=50
# PROCURESHIELD_RULE_WEIGHT=0.6
# PROCURESHIELD_MODEL_WEIGHT=0.4
# PROCURESHIELD_EPOCHS=200
# PROCURESHIELD_SEED=42
# PROCURESHIELD_GRAPH_BACKEND=memory
# Set only if the browser should call the engine directly (normally it does not).
# PROCURESHIELD_CORS_ORIGINS=http://localhost:5173
